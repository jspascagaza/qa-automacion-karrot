    suite = unittest.TestSuite()
    
    # Core
    suite.addTest(TestProductos('test_tc023'))
    suite.addTest(TestProductos('test_tc025'))
    
    if os.getenv('WEB_EXEC_EXHAUSTIVO') == 'true':
        print("[INFO] Validaciones secundarias activadas.")
        suite.addTest(TestProductos('test_tc024'))
        suite.addTest(TestProductos('test_tc026'))
    
    runner = unittest.TextTestRunner(verbosity=2, stream=sys.stdout)
    sys.exit(not runner.run(suite).wasSuccessful())
