        def encontrar_boton_eliminar():
            selectors = [
                "//button[contains(@class, 'ant-btn-primary') and contains(text(), 'Eliminar')]",
                "//button[contains(text(), 'Eliminar')]",
                "//span[contains(text(), 'Eliminar')]/ancestor::button",
